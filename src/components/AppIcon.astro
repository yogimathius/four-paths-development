---
import { Image } from "astro:assets";
import type { AppEntry } from "../lib/catalog";

interface Props {
  app: AppEntry;
  size?: number;
}
const { app, size = 56 } = Astro.props;
const { icon, path, name } = app.data;
---

{
  icon ? (
    <Image src={icon} alt="" width={size * 2} height={size * 2} class="icon" style={`width:${size}px;height:${size}px`} />
  ) : (
    <span class={`icon tile path-${path} on-path`} style={`width:${size}px;height:${size}px;font-size:${size * 0.42}px`} aria-hidden="true">
      {name.charAt(0)}
    </span>
  )
}

<style>
  .icon {
    border-radius: 24%;
    flex: none;
    display: block;
    box-shadow: 0 2px 10px rgb(31 27 46 / 0.12);
  }
  .tile {
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 800;
  }
</style>
