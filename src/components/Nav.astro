---
import Wordmark from "./Wordmark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/work", label: "Work" },
  { href: "/notes", label: "Notes" },
  { href: "/now", label: "Now" },
  { href: "/about", label: "About" },
];
const here = Astro.url.pathname;
---

<header class="wrap nav">
  <a href="/" class="home" aria-label="Four Paths home"><Wordmark /></a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={here === l.href || here.startsWith(l.href + "/") ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="contact" href="mailto:info@fourpaths.ca">Contact</a>
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.3rem;
    padding-bottom: 1.3rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .home {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(.5rem, 1.6vw, 1.5rem);
  }
  ul {
    display: flex;
    gap: clamp(.35rem, 1.2vw, 1.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  ul a {
    display: block;
    padding: .2rem 0;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: .85rem;
  }
  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--ink);
    box-shadow: 0 1px 0 var(--ink);
  }
  .contact { color: var(--ink); font-size: .85rem; text-decoration: none; border-bottom: 1px solid var(--line); }
  .contact:hover { border-color: var(--ink); }
  @media (max-width: 620px) {
    .nav { gap: .9rem; }
    nav { width: 100%; justify-content: space-between; }
    ul { gap: .75rem; }
    .contact { display: none; }
  }
</style>
