---
import Wordmark from "./Wordmark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/apps", label: "Apps" },
  { href: "/journal", label: "Journal" },
  { href: "/press", label: "Press" },
  { href: "/about", label: "About" },
];
const here = Astro.url.pathname;
---

<header class="wrap nav">
  <a href="/" class="home" aria-label="Four Paths home"><Wordmark /></a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={here === l.href || here.startsWith(l.href + "/") ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    flex-wrap: wrap;
  }
  .home {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  ul a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--ink);
    background: var(--chip);
  }
</style>
