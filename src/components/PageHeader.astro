---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
}
const { title, eyebrow, lede } = Astro.props;
---

<header class="page-head">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <slot name="above" />
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
