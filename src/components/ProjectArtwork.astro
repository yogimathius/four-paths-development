---
import { Image } from "astro:assets";
import type { Work } from "../lib/studio";
interface Props { project: Work; eager?: boolean; }
const { project, eager = false } = Astro.props;
---
<div class:list={["project-artwork", `art-${project.slug}`, { portrait: project.imageKind === "portrait" }]}>
  {project.image ? <Image src={project.image} alt={project.imageAlt!} width={680} loading={eager ? "eager" : "lazy"} /> : <div class="ledger-preview" aria-label="ClearLedger concept: balances, obligations and a payoff projection">
    <div class="ledger-top"><span>ClearLedger</span><span>Concept preview</span></div>
    <span class="ledger-label">A clearer way forward</span><span class="ledger-title">See the whole picture.</span>
    <div class="ledger-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="ledger-bottom"><span>Accounts</span><span>Obligations</span><span>Plan</span></div>
  </div>}
</div>
<style>
  .project-artwork{position:relative;display:grid;place-items:center;overflow:hidden;min-width:0;width:100%;height:100%;min-height:260px;background:var(--surface)}
  .project-artwork img{position:absolute;top:14%;left:50%;transform:translateX(-50%);display:block;object-fit:contain;width:auto;height:72%;max-height:380px;max-width:75%}
  .art-sadhana{background:#25352e}.art-sadhana img{border-radius:22%;max-width:62%;height:70%;filter:drop-shadow(0 18px 25px #0003)}
  .art-chore-credits{background:#344553}.art-chore-credits img{height:88%;max-width:76%;max-height:none;align-self:end;object-position:top;border-radius:14px 14px 0 0;border:6px solid #19242c;border-bottom:0;box-shadow:0 12px 36px #0004;top:auto;bottom:-10px;transform:translateX(-50%)}
  .art-life-atlas{background:#293c40}.art-life-atlas img{top:calc(50% - 74px);width:148px;height:148px;border-radius:30px;box-shadow:0 12px 36px #0003}
  .art-clearledger{background:#253b34;padding:1.7rem}.ledger-preview{background:#f0f4ef;color:#203b31;border-radius:9px;width:min(100%,360px);padding:1.4rem;box-shadow:0 14px 30px #0003}.ledger-top,.ledger-bottom{display:flex;justify-content:space-between;gap:1rem;font-size:.65rem}.ledger-top{border-bottom:1px solid #c6d4cb;padding-bottom:1rem;font-weight:600}.ledger-top span:last-child{color:#526459;font-weight:400}.ledger-label{display:block;font-size:.65rem;margin-top:1.2rem;color:#526459}.ledger-title{display:block;font:400 1.7rem/1.2 var(--display);margin:.5rem 0 1.5rem}.ledger-bars{display:flex;gap:8px;align-items:end;height:80px;border-bottom:1px solid #c6d4cb}.ledger-bars i{flex:1;background:#557d69;height:90%;border-radius:3px 3px 0 0}.ledger-bars i:nth-child(2){height:83%}.ledger-bars i:nth-child(3){height:70%}.ledger-bars i:nth-child(4){height:62%}.ledger-bars i:nth-child(5){height:47%}.ledger-bars i:nth-child(6){height:36%}.ledger-bars i:nth-child(7){height:24%}.ledger-bars i:nth-child(8){height:13%}.ledger-bottom{padding-top:1rem}
</style>
