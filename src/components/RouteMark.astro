---
interface Props { class?: string; size?: number; }
const className = Astro.props.class ?? "";
const width = Astro.props.size ?? 46;
const height = width * 60 / 46;
---
<svg class={className} width={width} height={height} viewBox="0 0 46 60" fill="none" aria-hidden="true" focusable="false">
  <path d="M4 30c9 0 12-19 22-19m-22 19c9 0 12 19 22 19M26 11c7 0 9 8 16 8M26 49c7 0 9-8 16-8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
  <circle cx="4" cy="30" r="2" fill="currentColor" />
</svg>
