---
import RouteMark from "./RouteMark.astro";
interface Props { size?: number; }
const { size = 22 } = Astro.props;
---

<span class="wordmark" style={`font-size:${size}px`}>
  <span class="visually-hidden">Four Paths</span>
  <RouteMark class="mark" />
  <span aria-hidden="true">Four Paths</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: .5em;
    font-family: var(--body);
    font-weight: 650;
    letter-spacing: -.045em;
    color: var(--ink);
    line-height: 1;
  }
  .wordmark :global(.mark) { width: 1.25em; height: 1.25em; color: var(--ink-soft); flex: none; }
</style>
