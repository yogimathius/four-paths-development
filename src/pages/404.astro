---
import PageLayout from "../layouts/PageLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<PageLayout title="Page not found">
  <div class="wrap page">
    <PageHeader title="This path doesn't go anywhere." lede="The page you're looking for has moved or never existed.">
      <p class="actions"><a class="btn" href="/">Back home</a> <a class="btn soft" href="/apps">See the apps</a></p>
    </PageHeader>
  </div>
</PageLayout>

<style>
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
