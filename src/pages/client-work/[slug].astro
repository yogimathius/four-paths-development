---
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import { clientProjects, type ClientProject } from "../../lib/clients";
import { site } from "../../site.config";

export function getStaticPaths() { return clientProjects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props as { project: ClientProject };
const nextProject = clientProjects[(clientProjects.findIndex((entry) => entry.slug === project.slug) + 1) % clientProjects.length];
const schema = { "@context": "https://schema.org", "@type": "CreativeWork", name: `${project.name} website`, description: project.summary, about: project.name, creator: { "@type": "Organization", name: site.name }, url: new URL(`/client-work/${project.slug}`, site.url).href, sameAs: project.url };
const sections = [
  { key: "starting" }, { key: "built" }, { key: "handover" },
  ...(project.beforeAfter ? [{ key: "beforeAfter" }] : []),
  ...(project.results ? [{ key: "results" }] : []),
  { key: "evolution" }, { key: "present" },
];
const num = (index: number) => String(index + 1).padStart(2, "0");
const inquiry = `mailto:${site.email}?subject=${encodeURIComponent("Project inquiry")}`;
---
<PageLayout title={`${project.name} case study`} description={project.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="wrap case-study">
    <header class="case-head">
      <div class="head-meta"><a href="/client-work" class="text-link">← Client work</a><span class="overline">{project.period}</span></div>
      <h1>{project.name}<span>.</span></h1>
      <p class="case-premise">{project.premise}</p>
      <p class="lede">{project.summary}</p>
      <p class="case-cta"><a class="button-link" href={project.url} rel="noopener">Visit {project.host} ↗</a></p>
    </header>
    <div class="shots">
      <figure class="shot-desktop"><Image src={project.desktop.src} alt={project.desktop.alt} width={1400} loading="eager" /></figure>
      <figure class="shot-mobile"><Image src={project.mobile.src} alt={project.mobile.alt} width={420} loading="eager" /></figure>
    </div>
    <div class="case-layout">
      <aside class="case-side"><span class="overline">Project record</span><dl><dt>Business</dt><dd>{project.descriptor}</dd><dt>Scope</dt><dd><ul class="scope">{project.scope.map((item) => <li>{item}</li>)}</ul></dd><dt>Built with</dt><dd>{project.stack.join(", ")}</dd></dl><a href={project.url} class="text-link" rel="noopener">{project.host} ↗</a></aside>
      <div class="case-body">
        <p class="short"><span class="overline">The short version</span>{project.short}</p>
        {sections.map((section, index) => <>
          {section.key === "starting" && <section><span class="section-number">{num(index)} / STARTING POINT</span><h2>What it needed</h2>{project.starting.map((p) => <p>{p}</p>)}</section>}
          {section.key === "built" && <section><span class="section-number">{num(index)} / WORK</span><h2>What we built</h2>{project.built.map((p) => <p>{p}</p>)}</section>}
          {section.key === "handover" && <section><span class="section-number">{num(index)} / HANDOVER</span><h2>What the team can do now</h2><ul class="check">{project.handover.map((item) => <li>{item}</li>)}</ul></section>}
          {section.key === "beforeAfter" && project.beforeAfter && <section><span class="section-number">{num(index)} / DIFFERENCE</span><h2>Before and after</h2><table class="compare"><thead><tr><th scope="col"><span class="visually-hidden">Area</span></th><th scope="col">Before</th><th scope="col">Now</th></tr></thead><tbody>{project.beforeAfter.map((row) => <tr><th scope="row">{row.label}</th><td data-label="Before">{row.before}</td><td data-label="Now">{row.after}</td></tr>)}</tbody></table></section>}
          {section.key === "results" && project.results && <section><span class="section-number">{num(index)} / SIGNAL</span><h2>{project.results.heading}</h2><table class="results"><tbody>{project.results.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table><p class="note">{project.results.note}</p></section>}
          {section.key === "evolution" && <section><span class="section-number">{num(index)} / CHANGE</span><h2>How it evolved</h2><ol class="evolution">{project.evolution.map((step) => <li><time>{step.date}</time><p>{step.text}</p></li>)}</ol></section>}
          {section.key === "present" && <section><span class="section-number">{num(index)} / PRESENT</span><h2>Where it stands</h2><p>{project.present}</p><div class="case-links"><a class="button-link" href={inquiry}>Talk about your project ↗</a><a class="text-link" href="/client-work">All client work →</a></div></section>}
        </>)}
      </div>
    </div>
    <nav class="case-next" aria-label="Continue exploring"><div><span class="overline">Next case study</span><a href={`/client-work/${nextProject.slug}`}>{nextProject.name} <span aria-hidden="true">→</span></a></div><a class="text-link" href="/work">See our own products</a></nav>
  </article>
</PageLayout>
<style>
  .case-head{padding:3.5rem 0 4rem}.head-meta{display:flex;justify-content:space-between;gap:2rem;margin-bottom:2rem}.case-head h1{font-size:clamp(3.2rem,8vw,7rem);margin:0}.case-head h1 span{color:var(--family)}.case-premise{font:400 clamp(1.7rem,3vw,2.8rem)/1.18 var(--display);margin:.3rem 0 1.4rem;max-width:24ch}.case-cta{margin:2rem 0 0}
  .shots{display:grid;grid-template-columns:minmax(0,1fr) 200px;gap:1.5rem;align-items:end;background:var(--surface);border:1px solid var(--line);padding:1.5rem}
  .shots figure{margin:0}.shots img{display:block;width:100%;height:auto;border:1px solid var(--line)}
  .shot-mobile{align-self:end}
  .case-layout{display:grid;grid-template-columns:240px minmax(0,700px);justify-content:space-between;gap:5rem;padding:6rem 0}
  .case-side{align-self:start;position:sticky;top:2rem;border-top:1px solid var(--line);padding-top:1.2rem}.case-side dl{display:grid;gap:.8rem;margin:2rem 0}.case-side dt{font:.7rem var(--mono);color:var(--ink-muted);text-transform:uppercase}.case-side dd{margin:0;color:var(--ink-soft)}
  .scope{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;padding:0;margin:0}.scope li{border:1px solid var(--line);border-radius:2px;padding:.15rem .5rem;font:600 .7rem/1.5 var(--mono);color:var(--ink-soft)}
  .case-body section{padding:0 0 3.5rem;margin-bottom:3.5rem;border-bottom:1px solid var(--line)}.case-body h2{font-size:clamp(2.1rem,3.2vw,3rem);margin:.55rem 0 1.1rem}.case-body p,.case-body li{color:var(--ink-soft);font-size:1.04rem;max-width:65ch}
  .section-number{font:.7rem var(--mono);letter-spacing:.1em;color:var(--ink-muted)}
  .check{list-style:none;padding:0;margin:0;display:grid;gap:.7rem}
  .results{width:100%;border-collapse:collapse;margin:1.2rem 0}.results th,.results td{border-top:1px solid var(--line);padding:.9rem 0;text-align:left;vertical-align:baseline}.results th{font-weight:400;color:var(--ink-soft);padding-right:1.5rem}.results td{font:400 1.7rem var(--display);color:var(--ink);text-align:right;white-space:nowrap}.results tr:last-child th,.results tr:last-child td{border-bottom:1px solid var(--line)}
  .short{border-left:2px solid var(--family);padding:.2rem 0 .2rem 1.2rem;margin:0 0 3.5rem;font:400 clamp(1.25rem,2vw,1.55rem)/1.35 var(--display)!important;color:var(--ink)!important}.short .overline{display:block;margin-bottom:.5rem;font:600 .7rem/1.4 var(--mono)}
  .compare{width:100%;border-collapse:collapse;margin:1rem 0}.compare th,.compare td{border-top:1px solid var(--line);padding:.9rem 1rem .9rem 0;text-align:left;vertical-align:top;font-size:.98rem}.compare thead th{font:600 .7rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted);border-top:0}.compare tbody th{font-weight:550;color:var(--ink)}.compare td{color:var(--ink-soft)}.compare tr:last-child th,.compare tr:last-child td{border-bottom:1px solid var(--line)}@media(max-width:600px){.compare thead{display:none}.compare tr{display:block;border-top:1px solid var(--line);padding:.8rem 0}.compare th,.compare td{display:block;border:0;padding:.15rem 0}.compare td::before{content:attr(data-label) " ";font:600 .65rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-muted)}}
  .note{font-size:.92rem!important;color:var(--ink-muted)!important}
  .evolution{list-style:none;padding:0;margin:2rem 0 0}.evolution li{display:grid;grid-template-columns:130px 1fr;gap:1.5rem;border-top:1px solid var(--line);padding:1.1rem 0}.evolution time{font:.75rem var(--mono);color:var(--ink-muted)}.evolution p{margin:0}
  .case-links{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:1.5rem}.case-links .text-link{color:var(--ink)}
  .case-next{border-top:1px solid var(--line);padding:2rem 0 4rem;display:flex;justify-content:space-between;align-items:end;gap:2rem}.case-next div>a{display:block;font:400 clamp(2rem,4vw,3.5rem) var(--display);color:var(--ink);text-decoration:none}
  @media(max-width:800px){.case-layout{grid-template-columns:1fr;gap:3rem;padding:4rem 0}.case-side{position:static}.shots{grid-template-columns:1fr;padding:1rem}.shot-mobile{max-width:220px}.case-next{align-items:start;flex-direction:column}}
  @media(max-width:600px){.head-meta{align-items:start;flex-direction:column;gap:.8rem}.case-head{padding:2.5rem 0 3rem}.evolution li{grid-template-columns:1fr;gap:.3rem}.results td{font-size:1.4rem}.results th{padding-right:.8rem}}
</style>
