---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import LensTags from "../components/LensTags.astro";
import RouteMark from "../components/RouteMark.astro";
import { featuredWork, selectedWork, lenses } from "../lib/studio";

const notes = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<PageLayout>
  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero-intro"><span class="overline">Four Paths / Independent product studio</span><span class="overline">01 — OPEN FIELD</span></div>
    <h1 id="hero-title">Thoughtful software for <em>practice, play, learning</em> and everyday life.</h1>
    <div class="hero-bottom">
      <p class="lede">Four Paths is an independent product studio exploring what technology can become when engineering, creativity, inquiry and real human life are allowed to shape one another.</p>
      <div class="hero-actions"><a class="button-link" href="/work">Explore the work →</a><a class="text-link" href="/notes">Read the notes</a></div>
    </div>
    <div class="hero-route" aria-hidden="true"><RouteMark size={180} /></div>
  </section>

  <section id="featured-work" class="feature-wrap" aria-labelledby="featured-title">
    <div class="wrap section-kicker"><span class="overline">Selected work / 01</span><span class="muted">A closer look at what exists</span></div>
    <div class="wrap feature-grid">
      <div class="feature-copy">
        <span class="status"><span aria-hidden="true"></span>{featuredWork.status}</span>
        <h2 id="featured-title">Sadhana<span class="period">.</span></h2>
        <p class="feature-premise">A yoga practice that grows with you.</p>
        <p class="feature-detail">A structured Hatha yoga curriculum with spoken guidance, progression, and sessions designed to let the phone rest beside the mat.</p>
        <LensTags tags={featuredWork.lenses} />
        <a class="text-link" href="/work/pillars">Explore Sadhana →</a>
      </div>
      <a class="feature-art" href="/work/pillars" aria-label="Sadhana project image">
        {featuredWork.image && <Image src={featuredWork.image} alt={featuredWork.imageAlt!} width={660} loading="eager" />}
        <span class="art-caption">SADHANA / PRACTICE 01</span>
      </a>
    </div>
  </section>

  <section class="wrap section selected" aria-labelledby="selected-title">
    <div class="section-head rule-heading"><div><span class="overline">Other inquiries</span><h2 id="selected-title">Work in different states.</h2></div><a class="text-link" href="/work">All work →</a></div>
    <div class="selected-grid">
      {selectedWork.map((project, index) => (
        <article class="selected-item">
          <div class="selected-art">{project.image && <Image src={project.image} alt={project.imageAlt!} width={500} />}</div>
          <div class="selected-info"><span class="overline">{project.status} / {String(index + 2).padStart(2, "0")}</span><h3><a href={`/work/${project.slug}`}>{project.name} ↗</a></h3><p>{project.premise}</p><LensTags tags={project.lenses} /></div>
        </article>
      ))}
    </div>
  </section>

  <section id="four-paths" class="paths-block" aria-labelledby="paths-title">
    <div class="wrap paths-layout">
      <div><span class="overline">The organizing idea</span><h2 id="paths-title">Four paths.<br /><em>One practice.</em></h2><p>The things I build rarely belong to one category. Technology becomes more interesting when it encounters creativity. Philosophy matters when it changes how something is made. Family and ordinary life expose assumptions that cleaner environments never reveal.</p></div>
      <div class="paths-diagram" aria-label="Four overlapping lenses">
        <svg class="lines" viewBox="0 0 500 440" preserveAspectRatio="none" aria-hidden="true"><path d="M250 220 C140 165 92 103 35 42 M250 220 C310 140 393 117 461 37 M250 220 C157 272 92 347 38 410 M250 220 C326 270 392 354 465 410" /><circle cx="250" cy="220" r="4" /></svg>
        {Object.entries(lenses).map(([key, lens], i) => <div class={`path-item path-${key}`}><span class="path-number">0{i + 1}</span><div><strong>{lens.verb}</strong><span>{lens.name}</span></div></div>)}
      </div>
    </div>
  </section>

  <section class="wrap section notes-home" aria-labelledby="notes-title">
    <div class="section-head rule-heading"><div><span class="overline">Field notes</span><h2 id="notes-title">Thinking in public.</h2></div><a class="text-link" href="/notes">All notes →</a></div>
    <div class="note-list">{notes.map((note) => <article class="note-row"><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time><div><h3><a href={`/notes/${note.id}`}>{note.data.title} ↗</a></h3><p>{note.data.description}</p></div><LensTags tags={note.data.lenses} /></article>)}</div>
  </section>

  <section class="wrap now-home" aria-labelledby="now-title"><div><span class="overline">October 2026 / Current position</span><h2 id="now-title">Now.</h2></div><p>Refining Sadhana in Android open testing, learning from real device use, and exploring tools that ask for less attention rather than more.</p><a class="text-link" href="/now">See what I’m working on →</a></section>
  <section class="wrap closing"><p>There is more to make, and more to learn from what is already here.</p><a href="mailto:info@fourpaths.ca">Start a conversation ↗</a></section>
</PageLayout>

<style>
  .hero{position:relative;padding-block:clamp(4.5rem,8vw,8rem) clamp(5rem,9vw,9rem);overflow:hidden}.hero-intro{display:flex;justify-content:space-between;gap:1rem;margin-bottom:2.5rem}.hero h1{font-size:clamp(3.2rem,6.4vw,6.25rem);max-width:1040px;margin-bottom:2.5rem;letter-spacing:-.045em}.hero h1 em,.paths-layout h2 em{font-weight:400;color:var(--ink-soft)}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end}.hero-bottom .lede{margin:0}.hero-actions{display:flex;align-items:center;gap:1.7rem;justify-content:flex-end}.hero-route{position:absolute;right:3%;bottom:0;opacity:.24;pointer-events:none}.feature-wrap{background:var(--surface);border-block:1px solid var(--line)}.section-kicker{display:flex;justify-content:space-between;padding-block:1.15rem;border-bottom:1px solid var(--line);font-size:.83rem}.feature-grid{display:grid;grid-template-columns:.9fr 1.1fr;min-height:620px}.feature-copy{padding:clamp(3rem,6vw,6rem) clamp(2rem,5vw,5rem) clamp(3rem,6vw,6rem) 0;display:flex;align-items:flex-start;flex-direction:column;justify-content:center}.status{font:600 .75rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);display:flex;align-items:center;gap:.6rem}.status span{height:.45rem;width:.45rem;background:var(--family);border-radius:50%}.feature-copy h2{font-size:clamp(4rem,8vw,8rem);margin:.3em 0 .05em}.period{color:var(--family)}.feature-premise{font:400 clamp(1.4rem,2.3vw,2rem)/1.2 var(--display);margin:0 0 1.4rem}.feature-detail{color:var(--ink-soft);max-width:41ch}.feature-copy .lens-tags{margin:1rem 0 2rem}.feature-art{position:relative;display:grid;place-items:center;min-height:500px;background:#252d29;border-inline:1px solid var(--line);overflow:hidden}.feature-art img{max-height:570px;width:auto;filter:drop-shadow(0 18px 40px #0006)}.art-caption{position:absolute;bottom:1.5rem;left:1.5rem;font:.65rem var(--mono);letter-spacing:.12em;color:var(--ink-muted)}.rule-heading{border-top:1px solid var(--line);padding-top:1.2rem;align-items:end}.rule-heading h2{margin:.3rem 0 0}.selected-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:4rem 2rem}.selected-item:first-child{grid-row:span 2}.selected-item{border-bottom:1px solid var(--line);padding-bottom:1.5rem}.selected-art{height:240px;display:grid;place-items:center;background:var(--surface);overflow:hidden;margin-bottom:1.4rem}.selected-item:first-child .selected-art{height:540px}.selected-art img{height:100%;width:auto;object-fit:contain}.selected-info h3{font-size:clamp(1.6rem,2.5vw,2.3rem);margin:.45rem 0 .3rem}.selected-info h3 a,.note-row h3 a{color:var(--ink);text-decoration:none}.selected-info p{color:var(--ink-soft);margin-bottom:.9rem}.paths-block{padding:clamp(5rem,8vw,8rem) 0;background:var(--surface);border-block:1px solid var(--line)}.paths-layout{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,8vw,8rem);align-items:center}.paths-layout h2{margin-top:1rem}.paths-layout p{max-width:52ch;color:var(--ink-soft)}.paths-diagram{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:6rem 4rem;padding:2rem 0;min-height:440px;align-items:center}.lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.lines path{fill:none;stroke:var(--line);stroke-width:1.2}.lines circle{fill:var(--ink-muted)}.path-item{position:relative;z-index:1;display:flex;gap:1rem;align-items:flex-start;background:var(--surface);padding:.4rem}.path-number{font:.72rem var(--mono);color:var(--path-color)}.path-item strong,.path-item div span{display:block}.path-item strong{font:600 .82rem var(--mono);letter-spacing:.1em;text-transform:uppercase}.path-item div span{font:400 1.4rem var(--display);color:var(--ink-soft)}.path-build{--path-color:var(--technology)}.path-create{--path-color:var(--creativity)}.path-question{--path-color:var(--philosophy)}.path-ground{--path-color:var(--family)}.note-row{display:grid;grid-template-columns:150px 1fr 210px;gap:2rem;border-bottom:1px solid var(--line);padding:1.7rem 0}.note-row time{font:.75rem var(--mono);color:var(--ink-muted);padding-top:.4rem}.note-row h3{font-size:1.55rem;margin:0 0 .35rem}.note-row p{color:var(--ink-soft);margin:0}.note-row .lens-tags{justify-content:flex-end}.now-home{display:grid;grid-template-columns:.5fr 1fr auto;gap:3rem;align-items:end;border-top:1px solid var(--line);padding:3rem 0}.now-home h2{margin:.5rem 0 0}.now-home p{margin:0;color:var(--ink-soft)}.closing{display:flex;justify-content:space-between;gap:2rem;align-items:center;padding:4rem 0;border-top:1px solid var(--line)}.closing p{font:400 1.8rem var(--display);max-width:28ch;margin:0}.closing a{color:var(--ink)}
  @media(max-width:850px){.hero-bottom,.feature-grid,.paths-layout{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.feature-copy{padding:3rem 0}.feature-art{min-height:400px;border-top:1px solid var(--line);border-inline:0}.feature-art img{max-height:420px}.selected-grid{gap:2rem}.selected-item:first-child{grid-row:auto}.selected-item:first-child .selected-art{height:300px}.note-row{grid-template-columns:110px 1fr}.note-row .lens-tags{grid-column:2;justify-content:flex-start}.now-home{grid-template-columns:1fr 2fr}.now-home a{grid-column:2}}
  @media(max-width:600px){.hero{padding-top:4rem;padding-bottom:5rem}.hero-intro span:last-child,.section-kicker .muted{display:none}.hero h1{font-size:clamp(3.1rem,12vw,4.2rem)}.hero-bottom{gap:1.7rem}.hero-actions{gap:1.3rem;flex-wrap:wrap}.feature-grid{min-height:0}.feature-art{min-height:340px}.feature-art img{max-height:330px}.selected-grid{grid-template-columns:1fr}.selected-art,.selected-item:first-child .selected-art{height:240px}.paths-diagram{gap:2.5rem 1rem;min-height:300px}.path-item{gap:.35rem}.path-item div span{font-size:1.1rem}.note-row{grid-template-columns:1fr;gap:.4rem}.note-row .lens-tags{grid-column:1}.now-home{grid-template-columns:1fr;gap:1rem}.now-home a{grid-column:1}.closing{align-items:flex-start;flex-direction:column}}
  .art-caption{color:#c5cac3}
</style>
