---
import PageLayout from "../layouts/PageLayout.astro";
import AppCard from "../components/AppCard.astro";
import AppIcon from "../components/AppIcon.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { listedApps } from "../lib/catalog";
import { publishedPosts, formatDate } from "../lib/journal";
import PathCard from "../components/PathCard.astro";
import { PATHS } from "../lib/paths";
import { site } from "../site.config";

const apps = await listedApps();
const testing = apps.filter((a) => a.data.status === "testing" && a.data.recruitingTesters);
const posts = (await publishedPosts()).slice(0, 3);
const principles = [
  {
    title: "Agency over compulsion",
    body: "No streaks to protect, no leaderboards between siblings, no reward loops built to keep you tapping. A good tool is easy to put down.",
  },
  {
    title: "Stewardship over extraction",
    body: "We ask for as little as we can, keep it on your device wherever possible, and never sell it. When an app needs a server, its policy names exactly what goes there.",
  },
  {
    title: "Truth over persuasion",
    body: "Every privacy policy opens with a plain-language short version, every app explains how to delete your data, and every app's status says honestly where it is.",
  },
];
---

<PageLayout>
  <section class="wrap hero">
    <div class="dots" aria-hidden="true">{PATHS.map((p) => <i class={`path-${p}`}></i>)}</div>
    <h1>Small, private apps for the things that matter.</h1>
    <p class="lede">{site.description}</p>
    <p class="actions">
      <a class="btn" href="/apps">See the apps</a>
      <a class="btn soft" href="/journal">Read the journal</a>
    </p>
  </section>

  <section class="wrap section" aria-labelledby="apps-title">
    <div class="section-head">
      <h2 id="apps-title">The apps</h2>
      <p><a href="/apps">All apps →</a></p>
    </div>
    <div class="grid-apps">{apps.map((app) => <AppCard app={app} />)}</div>
  </section>

  <section class="wrap section" aria-labelledby="build-title">
    <div class="section-head">
      <h2 id="build-title">The standard we build to</h2>
      <p class="muted">Technology that serves the person using it, not the other way around.</p>
    </div>
    <div class="grid-3">
      {
        principles.map((p) => (
          <div class="glass feature">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    testing.length > 0 && (
      <section class="wrap section" aria-labelledby="test-title">
        <div class="glass launch">
          <div>
            <span class="eyebrow">Now in closed testing</span>
            <h2 id="test-title">Help us launch</h2>
            <p class="muted">
              Google Play only lets an app launch publicly once a group of testers has stayed opted in for 14 days. If
              you have an Android phone, joining a test is the most useful thing you can do for a small studio.
            </p>
          </div>
          <ul>
            {testing.map((app) => (
              <li>
                <AppIcon app={app} size={40} />
                <a href={`/apps/${app.id}#test`}>{app.data.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="wrap section" aria-labelledby="paths-title">
    <div class="section-head">
      <h2 id="paths-title">Four paths</h2>
      <p class="muted">Where the work lives, how it's practised, and what it serves. <a href="/journal/why-four-paths">Why four paths →</a></p>
    </div>
    <ul class="paths">{PATHS.map((p) => <PathCard path={p} />)}</ul>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap section" aria-labelledby="journal-title">
        <div class="section-head">
          <h2 id="journal-title">From the journal</h2>
          <p><a href="/journal">All posts →</a></p>
        </div>
        <ul class="posts">
          {posts.map((post) => (
            <li class="glass post">
              <time datetime={post.data.date.toISOString()} class="muted">{formatDate(post.data.date)}</time>
              <h3>
                <a href={`/journal/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="wrap section"><NewsletterForm /></div>
</PageLayout>

<style>
  .hero {
    padding-top: 3.5rem;
    padding-bottom: 1rem;
  }
  .hero h1 {
    max-width: 16ch;
  }
  .dots {
    display: flex;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }
  .dots i {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
  }
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .launch {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
  }
  @media (min-width: 860px) {
    .launch {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 3rem;
    }
  }
  .launch h2 {
    margin-top: 0.5rem;
  }
  .launch p {
    margin: 0;
    max-width: 56ch;
  }
  .launch ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .launch li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
  }
  .launch li a {
    color: var(--ink);
  }
  .paths,
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .post {
    padding: 1.25rem;
  }
  .post time {
    font-size: 0.85rem;
  }
  .post h3 {
    margin-top: 0.4rem;
  }
  .post h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .post p {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
