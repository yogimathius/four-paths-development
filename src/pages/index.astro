---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import ProjectArtwork from "../components/ProjectArtwork.astro";
import LensTags from "../components/LensTags.astro";
import RouteMark from "../components/RouteMark.astro";
import { featuredWork, selectedWork, lenses } from "../lib/studio";
import { clientProjects } from "../lib/clients";
import practiceArtwork from "../assets/work/pillars-pose.png";
const notes = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<PageLayout>
  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="hero-context">Software with a life beyond the screen.</p><h1 id="hero-title">Thoughtful software.<br />Built around real life.</h1><p class="lede">Apps for practice, play and everyday life. Websites and tools that help good businesses do their work.</p><div class="hero-actions"><a class="button-link" href="/work">Explore the products</a><a class="text-link" href="/client-work">See client work</a></div><div class="hero-origin"><RouteMark size={30} /><span>Independent in spirit.<br />Made with care in Canada.</span></div></div>
    <a class="hero-project" href="/work/sadhana" aria-label="Explore Sadhana, our Hatha yoga app"><div class="practice-art"><Image src={practiceArtwork} alt="Illustration from Sadhana: a standing yoga practice with a geometric sun and moon" width={550} loading="eager" /><span class="practice-note">A little space<br />for your practice.</span></div><div class="hero-project-caption"><div><span class="project-live">Live on Google Play</span><strong>Sadhana</strong><span>Hatha yoga, at your own pace.</span></div><span class="project-arrow" aria-hidden="true">↗</span></div></a>
  </section>
  <section id="work-with-us" class="wrap invite" aria-labelledby="invite-title"><h2 id="invite-title">Your next chapter<br />might begin here.</h2><div><p>Four Paths creates independent software and partners with thoughtful organizations to improve the technology they rely on. A website migration, a better content editor, or an app with a job to do.</p><a class="text-link" href={`/client-work#start`}>Talk about your project</a></div></section>
  <section id="featured-work" class="feature-wrap" aria-labelledby="featured-title"><div class="wrap feature-grid"><div class="feature-copy"><span class="project-live">{featuredWork.status}</span><h2 id="featured-title">Sadhana</h2><p class="feature-premise">A yoga practice that grows with you.</p><p>Spoken guidance, a clear place to begin, and stages to grow through. Put the phone beside the mat and give your attention to the practice.</p><p class="free-practice">Start with a free beginner practice. No subscription needed.</p><div class="feature-actions">{featuredWork.storeUrl && <a class="button-link" href={featuredWork.storeUrl}>Get it on Google Play</a>}<a class="text-link" href="/work/sadhana">Explore Sadhana</a><a class="text-link" href={featuredWork.siteUrl}>sadhanawithin.com ↗</a></div></div><a class="feature-art" href="/work/sadhana" aria-label="Sadhana project"><ProjectArtwork project={featuredWork} /></a></div></section>
  <section class="wrap section" aria-labelledby="selected-title"><div class="section-head"><div><p class="overline">From the studio</p><h2 id="selected-title">More ways to make life work.</h2></div><a class="text-link" href="/work">All products</a></div><div class="selected-grid">{selectedWork.map((project) => <article class="selected-item"><a class="selected-art" href={`/work/${project.slug}`} aria-label={`Explore ${project.name}`}><ProjectArtwork project={project} /></a><div class="selected-info"><span class="overline">{project.status}</span><h3><a href={`/work/${project.slug}`}>{project.name}</a></h3><p>{project.premise}</p></div></article>)}</div></section>
  <section id="client-work" class="wrap section clients" aria-labelledby="clients-title"><div class="section-head"><div><p class="overline">Client work</p><h2 id="clients-title">Good businesses.<br />Better tools behind them.</h2></div><a class="text-link" href="/client-work">All client work</a></div><div class="client-grid">{clientProjects.map((project) => <article class="client-card"><a class="client-shot" href={`/client-work/${project.slug}`} aria-label={`${project.name} case study`}><div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span><small>{project.host}</small></div><Image src={project.desktop.src} alt={project.desktop.alt} width={900} /></a><div class="client-info"><h3><a href={`/client-work/${project.slug}`}>{project.name}<span aria-hidden="true">↗</span></a></h3><p>{project.premise}</p></div></article>)}</div></section>
  <section id="four-paths" class="paths-block" aria-labelledby="paths-title"><div class="wrap paths-layout"><div><RouteMark size={60} /><h2 id="paths-title">Four paths.<br />One practice.</h2><p>Useful things rarely come from one discipline alone. Engineering, creativity, inquiry and everyday life each bring something the others miss.</p><a class="text-link" href="/about">The thinking behind the work</a></div><div class="paths-grid">{Object.entries(lenses).map(([key, lens]) => <div class={`path path-${key}`}><span class="path-dot" aria-hidden="true"></span><h3>{lens.verb}</h3><p>{lens.description}</p></div>)}</div></div></section>
  <section class="wrap section notes-home" aria-labelledby="notes-title"><div class="section-head"><div><p class="overline">Field notes</p><h2 id="notes-title">Ideas taking shape.</h2></div><a class="text-link" href="/notes">All notes</a></div><div class="note-list">{notes.map((note) => <article class="note-row"><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time><div><h3><a href={`/notes/${note.id}`}>{note.data.title}</a></h3><p>{note.data.description}</p></div><LensTags tags={note.data.lenses} /></article>)}</div></section>
  <section class="wrap now-home" aria-labelledby="now-title"><div><span class="overline">November 2026</span><h2 id="now-title">In the works.</h2></div><p>Sadhana is on Google Play. We’re learning from real practice, refining our apps, and caring for the sites our clients run.</p><a class="text-link" href="/now">The studio right now</a></section>
</PageLayout>
<style>
  .hero{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(2rem,5vw,5rem);align-items:center;padding-block:4rem 4.5rem}.hero-context{font-size:.82rem;color:var(--ink-muted);margin-bottom:1.6rem}.hero h1{font-size:clamp(3.3rem,4.7vw,4.6rem);line-height:1.04;letter-spacing:-.045em;margin-bottom:1.4rem;text-wrap:initial}.hero .lede{font-size:1.1rem;max-width:40ch}.hero-actions{display:flex;align-items:center;gap:1.5rem;margin-top:2rem;flex-wrap:wrap}.hero-origin{display:flex;align-items:center;gap:.9rem;color:var(--ink-muted);font-size:.73rem;line-height:1.6;margin-top:3rem}.hero-origin svg{color:var(--family)}
  .hero-project{display:block;color:var(--ink);text-decoration:none;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface)}.practice-art{position:relative;display:grid;place-items:center;background:#364e4b;height:400px;overflow:hidden}.practice-art img{position:absolute;inset:4% 0;height:92%;width:100%;max-width:100%;object-fit:contain;margin:0;transform:translateX(2rem)}.practice-note{position:absolute;top:2rem;left:1.8rem;font:400 1.5rem/1.15 var(--display);color:#f1efe7;max-width:10ch}.hero-project-caption{padding:1.3rem 1.6rem;display:flex;justify-content:space-between;align-items:center;gap:1rem}.hero-project-caption strong{display:block;font:400 2rem var(--display);margin:.35rem 0 .1rem}.hero-project-caption div>span:last-child{font-size:.8rem;color:var(--ink-soft)}.project-live{display:flex;align-items:center;gap:.5rem;font-size:.75rem;color:var(--ink-soft)}.project-live:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--family)}.project-arrow{display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;width:42px;height:42px;font-size:1.2rem}
  .invite{display:grid;grid-template-columns:1fr 1.3fr;gap:4rem;border-top:1px solid var(--line);padding-block:2.5rem 3rem}.invite h2{font-size:2rem;margin:0}.invite p{color:var(--ink-soft);max-width:64ch;font-size:.96rem}.invite .text-link{font-size:.88rem}
  .feature-wrap{background:var(--surface);border-block:1px solid var(--line)}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;padding-block:3.5rem}.feature-copy h2{font-size:4.5rem;margin:.5rem 0}.feature-premise{font:400 1.8rem/1.2 var(--display);color:var(--ink)!important}.feature-copy>p{color:var(--ink-soft);max-width:48ch}.feature-copy .free-practice{font-size:.85rem;color:var(--ink)}.feature-actions{display:flex;gap:1rem 1.5rem;align-items:center;flex-wrap:wrap;margin-top:1.8rem}.feature-actions .text-link{font-size:.83rem}.feature-art{height:400px;display:block;border-radius:8px;overflow:hidden}.section-head{margin-bottom:2rem}.section-head .overline{margin-bottom:.65rem}.section-head h2{font-size:clamp(2rem,3.7vw,3.1rem)}.section-head>.text-link{font-size:.85rem;flex-shrink:0}.selected-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.selected-art{height:290px;display:block;border-radius:8px;overflow:hidden}.selected-info{padding-top:1.2rem}.selected-info h3{font-size:1.8rem;margin:.45rem 0 .5rem}.selected-info h3 a,.client-info h3 a,.note-row h3 a{color:var(--ink);text-decoration:none}.selected-info p{font-size:.92rem;max-width:30ch;color:var(--ink-soft);margin:0}.clients{padding-top:0}.client-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.client-shot{display:block;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface)}.client-shot img{display:block;width:100%;height:auto;aspect-ratio:1.6;object-fit:cover;object-position:top}.browser-bar{height:29px;display:flex;align-items:center;gap:5px;padding-inline:12px;background:var(--surface-raised)}.browser-bar>span{display:block;width:5px;height:5px;border-radius:50%;background:var(--ink-muted);opacity:.6}.browser-bar small{font-size:.6rem;color:var(--ink-soft);margin-left:10px}.client-info{padding-top:1.2rem}.client-info h3{font-size:1.8rem;margin-bottom:.5rem}.client-info h3 a{display:flex;justify-content:space-between;gap:1rem}.client-info h3 span{font:400 1.1rem var(--body);color:var(--ink-muted)}.client-info p{color:var(--ink-soft);font-size:.92rem;max-width:44ch;margin:0}
  .paths-block{padding-block:4.5rem;background:var(--surface);border-block:1px solid var(--line)}.paths-layout{display:grid;grid-template-columns:1fr 1.1fr;gap:6rem;align-items:center}.paths-layout>div>svg{color:var(--family);margin-bottom:1rem}.paths-layout h2{font-size:3.4rem}.paths-layout>div>p{color:var(--ink-soft);max-width:43ch}.paths-layout .text-link{font-size:.85rem}.paths-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem 2rem}.path-dot{display:block;width:8px;height:8px;border-radius:50%;background:var(--path-color);margin-bottom:1.3rem}.path h3{font-size:1.8rem;margin-bottom:.6rem}.path p{font-size:.88rem;color:var(--ink-soft);margin:0}.path-build{--path-color:var(--technology)}.path-create{--path-color:var(--creativity)}.path-question{--path-color:var(--philosophy)}.path-ground{--path-color:var(--family)}
  .note-list{border-top:1px solid var(--line)}.note-row{display:grid;grid-template-columns:120px 1fr 175px;gap:2rem;padding:1.7rem 0;border-bottom:1px solid var(--line);align-items:start}.note-row time{color:var(--ink-muted);font-size:.75rem;margin-top:.35rem}.note-row h3{font-size:1.8rem;margin-bottom:.45rem}.note-row p{color:var(--ink-soft);font-size:.92rem;margin:0;max-width:65ch}.note-row :global(.lens-tags){justify-content:flex-end;padding-top:.4rem}.now-home{display:grid;grid-template-columns:1fr 1.5fr auto;gap:3rem;align-items:center;border-top:1px solid var(--line);padding-block:2.5rem}.now-home h2{font-size:2.5rem;margin:.4rem 0 0}.now-home p{color:var(--ink-soft);font-size:.92rem;margin:0}.now-home .text-link{font-size:.82rem}
  @media(min-width:1450px){.hero{padding-block:5rem}.practice-art{height:440px}}
  @media(max-width:950px){.hero{gap:2rem}.hero h1{font-size:3.7rem}.practice-art{height:370px}.practice-note{font-size:1.5rem;left:1rem}.hero-origin{margin-top:2rem}.selected-grid{gap:1rem}.selected-art{height:250px}.feature-grid{gap:2rem}.paths-layout{gap:3rem}.note-row{grid-template-columns:95px 1fr}.note-row :global(.lens-tags){grid-column:2;justify-content:flex-start}.now-home{grid-template-columns:1fr 2fr}.now-home>.text-link{grid-column:2;width:fit-content}}
  @media(max-width:700px){.hero{grid-template-columns:1fr;padding-block:2.5rem 3rem;gap:2rem}.hero h1{font-size:clamp(3rem,10vw,4.5rem);max-width:15ch}.hero-context{margin-bottom:1.2rem}.hero .lede{font-size:1rem;max-width:44ch}.hero-origin{display:none}.hero-actions{margin-top:1.6rem}.practice-art{height:310px}.practice-art img{transform:translateX(1rem)}.practice-note{left:1.5rem;font-size:1.8rem}.hero-project-caption{padding:1rem 1.3rem}.invite{grid-template-columns:1fr;gap:1rem;padding-block:2rem}.invite h2{font-size:1.8rem}.invite h2 br{display:none}.feature-grid{grid-template-columns:1fr;padding-block:2.5rem}.feature-copy h2{font-size:3.8rem}.feature-art{height:320px}.selected-grid{grid-template-columns:1fr;gap:2rem}.selected-art{height:310px}.selected-info p{max-width:none}.selected-info h3{font-size:2rem}.client-grid{grid-template-columns:1fr;gap:2.3rem}.paths-layout{grid-template-columns:1fr;gap:2.5rem}.paths-layout h2{font-size:3rem}.paths-block{padding-block:3rem}.paths-grid{gap:2rem 1.4rem}.path p{font-size:.85rem}.note-row{grid-template-columns:1fr;gap:.65rem}.note-row :global(.lens-tags){grid-column:1}.note-row h3{font-size:1.7rem}.now-home{grid-template-columns:1fr;gap:1.2rem}.now-home>.text-link{grid-column:1}.section-head{gap:1.2rem}}
</style>
