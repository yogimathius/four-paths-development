---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import AppCard from "../components/AppCard.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { listedApps } from "../lib/catalog";
import { PATHS, PATH_INFO } from "../lib/paths";
import { site } from "../site.config";

const apps = await listedApps();
const posts = (await getCollection("journal", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<PageLayout>
  <section class="wrap hero">
    <div class="dots" aria-hidden="true">{PATHS.map((p) => <i class={`path-${p}`}></i>)}</div>
    <h1>Small, private apps for the things that matter.</h1>
    <p class="lede">{site.description}</p>
    <p class="actions">
      <a class="btn" href="/apps">See the apps</a>
      <a class="btn soft" href="/about">About the studio</a>
    </p>
  </section>

  <section class="wrap section" aria-labelledby="apps-title">
    <h2 id="apps-title">The apps</h2>
    <div class="grid-apps">{apps.map((app) => <AppCard app={app} />)}</div>
  </section>

  <section class="wrap section" aria-labelledby="paths-title">
    <h2 id="paths-title">Four paths</h2>
    <p class="muted intro">Every app grows from one of the four things the studio cares about. The colour tells you which.</p>
    <ul class="paths">
      {
        PATHS.map((p) => (
          <li class={`path path-${p} on-path`}>
            <h3>{PATH_INFO[p].label}</h3>
            <p>{PATH_INFO[p].blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap section" aria-labelledby="journal-title">
        <h2 id="journal-title">From the journal</h2>
        <ul class="posts">
          {posts.map((post) => (
            <li class="glass post">
              <time datetime={post.data.date.toISOString()} class="muted">
                {post.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
              </time>
              <h3>
                <a href={`/journal/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="muted">{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="wrap section"><NewsletterForm /></div>
</PageLayout>

<style>
  .hero {
    padding-top: 3.5rem;
    padding-bottom: 1rem;
  }
  .hero h1 {
    max-width: 16ch;
  }
  .dots {
    display: flex;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }
  .dots i {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
  }
  .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .intro {
    max-width: 52ch;
  }
  .paths,
  .posts {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .path {
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .path p {
    margin: 0;
    font-size: 0.95rem;
  }
  .post {
    padding: 1.25rem;
  }
  .post time {
    font-size: 0.85rem;
  }
  .post h3 {
    margin-top: 0.4rem;
  }
  .post h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .post p {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
