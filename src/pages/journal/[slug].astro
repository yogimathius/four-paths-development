---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import { site } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getCollection("journal", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"journal"> };
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<PageLayout title={post.data.title} description={post.data.description}>
  <article class="wrap section">
    <p class="muted meta"><a href="/journal">Journal</a> · <time datetime={post.data.date.toISOString()}>{date}</time> · {site.name}</p>
    <h1>{post.data.title}</h1>
    <div class="prose body"><Content /></div>
  </article>
</PageLayout>

<style>
  h1 {
    max-width: 22ch;
  }
  .meta {
    font-size: 0.9rem;
  }
  .body {
    font-size: 1.08rem;
    margin-top: 1.5rem;
  }
</style>
