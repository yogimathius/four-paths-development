---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { loadCatalog } from "../../lib/catalog";
import { publishedPosts, formatDate } from "../../lib/journal";
import { PATH_INFO } from "../../lib/paths";
import { site } from "../../site.config";

const posts = await publishedPosts();
const { apps } = await loadCatalog();
const appFor = (slug?: string) => apps.find((a) => a.id === slug);
---

<PageLayout title="Journal archive" description="Archived app introductions and early studio writing from Four Paths. Current writing is in Notes.">
  <div class="wrap page">
    <PageHeader eyebrow="Journal" title="Notes from the studio" lede="App introductions, launches, and what we're learning along the way." />
    <div class="split">
      <ul class="list">
        {
          posts.map((post) => {
            const app = appFor(post.data.app);
            return (
              <li class="glass">
                <p class="meta muted">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  {app && (
                    <span class={`chip path-${app.data.path} on-path`}>{PATH_INFO[app.data.path].label} · {app.data.name}</span>
                  )}
                </p>
                <h2>
                  <a href={`/journal/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="muted">{post.data.description}</p>
              </li>
            );
          })
        }
      </ul>
      <aside class="rail">
        <div class="glass panel">
          <h2>Current writing</h2>
          <p>This Journal is an archive. New writing appears in <a href="/notes">Current Notes</a>.</p>
          <p>RSS includes new Notes, not this archive.</p>
          <p><a href="/rss.xml">Subscribe to Notes with RSS</a></p>
        </div>
        <div class="glass panel">
          <h2>Say hello</h2>
          <p>Questions or ideas about any of the apps: <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  li {
    padding: 1.4rem 1.5rem;
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.85rem;
    margin: 0;
  }
  h2 {
    font-size: 1.4rem;
    margin: 0.5rem 0 0.4rem;
  }
  li h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  li > p:last-child {
    margin: 0;
  }
</style>
