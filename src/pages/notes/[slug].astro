---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import LensTags from "../../components/LensTags.astro";
import { workBySlug } from "../../lib/studio";
import { site } from "../../site.config";

export async function getStaticPaths() { return (await getCollection("notes")).map((note) => ({ params: { slug: note.id }, props: { note } })); }
const { note } = Astro.props as { note: CollectionEntry<"notes"> };
const { Content } = await render(note);
const project = note.data.project ? workBySlug(note.data.project) : undefined;
const schema = { "@context": "https://schema.org", "@type": "Article", headline: note.data.title, description: note.data.description, datePublished: note.data.date.toISOString(), author: { "@type": "Person", name: site.founderName }, publisher: { "@type": "Organization", name: site.name }, mainEntityOfPage: new URL(`/notes/${note.id}`, site.url).href };
---
<PageLayout title={note.data.title} description={note.data.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="wrap article">
    <header class="article-head"><a class="text-link" href="/notes">← All notes</a><div class="meta"><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time><span>By Mathius Johnson</span></div><h1>{note.data.title}</h1><p class="lede">{note.data.description}</p><LensTags tags={note.data.lenses} /></header>
    <div class="article-layout"><aside><span class="overline">From the studio</span><p>Ideas are tested in the work, not just on this page.</p></aside><div class="prose"><Content /></div></div>
    <footer class="article-footer"><div><span class="overline">Go deeper</span>{project ? <a href={`/work/${project.slug}`}>Explore {project.name} →</a> : <a href="/work">Explore the work →</a>}</div><a class="text-link" href="/notes">More notes</a></footer>
  </article>
</PageLayout>
<style>
  .article-head{max-width:950px;padding:3.5rem 0 4rem}.article-head .meta{display:flex;gap:1.5rem;margin:3rem 0 1.5rem;font:.74rem var(--mono);color:var(--ink-muted);text-transform:uppercase;letter-spacing:.08em}.article-head h1{max-width:15ch}.article-head .lens-tags{margin-top:2rem}.article-layout{display:grid;grid-template-columns:200px minmax(0,680px);justify-content:space-between;gap:4rem;border-top:1px solid var(--line);padding:4rem 0}.article-layout aside{color:var(--ink-muted);font-size:.9rem}.article-layout aside p{margin-top:1rem}.article-layout .prose{font-size:1.1rem;line-height:1.75}.article-layout .prose :global(p:first-child){font-size:1.22rem;color:var(--ink)}.article-footer{display:flex;justify-content:space-between;gap:2rem;border-top:1px solid var(--line);padding:2rem 0 4rem}.article-footer div>a{display:block;color:var(--ink);text-decoration:none;font:400 2rem var(--display);margin-top:.5rem}@media(max-width:700px){.article-layout{grid-template-columns:1fr;gap:1rem}.article-head .meta{display:block}.article-head .meta>*{display:block;margin-bottom:.5rem}.article-footer{align-items:flex-start;flex-direction:column}}
</style>
