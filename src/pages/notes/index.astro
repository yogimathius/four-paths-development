---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import LensTags from "../../components/LensTags.astro";
const notes = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<PageLayout title="Notes" description="Working ideas on software, practice, agency, families and the making of Four Paths projects.">
  <div class="wrap page">
    <header class="notebook-head"><div><h1>The notebook.</h1><p class="lede">Decisions, discoveries and ideas from the work.</p></div><a class="text-link" href="/rss.xml">Follow via RSS</a></header>
    <div class="notes-list">{notes.map((note) => <article class="note"><div><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time><h2><a href={`/notes/${note.id}`}>{note.data.title}</a></h2><p>{note.data.description}</p><LensTags tags={note.data.lenses} /></div></article>)}</div>
    <div class="ending"><p>The ideas behind the apps, and what happens when they meet real life.</p><a class="text-link" href="/work">Explore the work →</a></div>
  </div>
</PageLayout>
<style>
  .notebook-head{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding:1rem 0 2.5rem}.notebook-head h1{font-size:clamp(3rem,5vw,4.5rem)}.notebook-head .lede{margin:0}.notebook-head>a{flex-shrink:0;font-size:.85rem;margin-bottom:.3rem}@media(max-width:600px){.notebook-head{align-items:start;flex-direction:column;gap:1rem}} .page-head{padding-bottom:4rem}.page-head h1{margin:.7rem 0 1.2rem}.page-head h1 em{font-weight:400;color:var(--ink-soft)}.notes-list{border-top:1px solid var(--line)}.note{display:grid;grid-template-columns:1fr;gap:2rem;padding:2.6rem 0;border-bottom:1px solid var(--line)}.note-number{font:.75rem var(--mono);color:var(--ink-muted)}.note time{font:.72rem var(--mono);color:var(--ink-muted);text-transform:uppercase;letter-spacing:.07em}.note h2{font-size:clamp(2rem,4vw,3.3rem);margin:.5rem 0}.note h2 a{color:var(--ink);text-decoration:none}.note p{color:var(--ink-soft);max-width:60ch}.note .lens-tags{margin-top:1.3rem}.ending{display:flex;justify-content:space-between;gap:2rem;padding:4rem 0}.ending p{color:var(--ink-soft)}@media(max-width:600px){.note{grid-template-columns:1fr;gap:.5rem}.ending{display:block}}
</style>
