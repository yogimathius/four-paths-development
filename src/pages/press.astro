---
import PageLayout from "../layouts/PageLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { work } from "../lib/studio";
import { site } from "../site.config";
---

<PageLayout title="Press" description={`Press kit for ${site.name}: boilerplate, wordmark, and app details.`}>
  <div class="wrap page">
    <PageHeader eyebrow="Press" title="Press kit" lede={`Everything you need to write about ${site.name}.`} />
    <div class="split">
    <section class="narrow">

    <h2>Boilerplate</h2>
    <blockquote class="glass">
      {site.name} is an independent product studio in {site.country}{site.founderName ? `, founded by ${site.founderName}` : ""}. It
      builds thoughtful software for practice, play, learning and everyday life.
    </blockquote>

    <h2>Wordmark</h2>
    <div class="marks">
      <a class="glass mark" href="/press/four-paths-wordmark.png" download>
        <img src="/press/four-paths-wordmark.png" alt="Four Paths route-mark wordmark with dark lettering" width="320" height="83" />
        <span>Wordmark, for light backgrounds (PNG)</span>
      </a>
      <a class="glass mark dark" href="/press/four-paths-wordmark-light.png" download>
        <img src="/press/four-paths-wordmark-light.png" alt="Four Paths route-mark wordmark with warm light lettering" width="320" height="83" />
        <span>Wordmark, for dark backgrounds (PNG)</span>
      </a>
    </div>

    <h2>Work</h2>
    <ul class="apps">
      {
        work.map((project) => (
          <li class="glass">
            <div>
              <strong><a href={`/work/${project.slug}`}>{project.name}</a></strong>
              <span class="muted"> · {project.status}</span>
              <p class="muted">{project.premise}</p>
            </div>
          </li>
        ))
      }
    </ul>
    </section>
    <aside class="rail">
      <div class="glass panel">
        <h2>Facts</h2>
        <dl>
          <dt>Studio</dt><dd>{site.name}</dd>
          {site.founderName && (<><dt>Founder</dt><dd>{site.founderName}</dd></>)}
          <dt>Based in</dt><dd>{site.country}</dd>
          <dt>Website</dt><dd><a href={site.url}>{site.url.replace("https://", "")}</a></dd>
        </dl>
      </div>
      <div class="glass panel">
        <h2>Press contact</h2>
        <p><a href={`mailto:${site.email}?subject=Press`}>{site.email}</a></p>
        <p class="muted">Review access to apps in closed testing is available on request.</p>
      </div>
    </aside>
    </div>
  </div>
</PageLayout>

<style>
  .narrow h2 {
    margin-top: 2.75rem;
  }
  .narrow h2:first-child {
    margin-top: 0;
  }
  blockquote {
    margin: 0;
    padding: 1.25rem 1.4rem;
    font-size: 1.05rem;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.45rem 1rem;
    margin: 0;
    font-size: 0.93rem;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  .marks {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .mark {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
  }
  .mark img {
    border-radius: 2px;
    padding: 0.75rem;
    background: #f1efe7;
  }
  .mark.dark img {
    background: #161a18;
  }
  .apps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .apps li {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }
  .apps p {
    margin: 0.2rem 0 0;
    font-size: 0.92rem;
  }
</style>
