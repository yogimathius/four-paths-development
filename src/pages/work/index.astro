---
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectArtwork from "../../components/ProjectArtwork.astro";
import { work } from "../../lib/studio";
---
<PageLayout title="Products" description="Independent apps from Four Paths: Sadhana for Hatha yoga, Chore Credits for family life, Life Atlas and ClearLedger.">
  <div class="wrap products-page">
    <header class="products-head"><h1>Made for<br />the everyday.</h1><div><p class="lede">A practice to return to. A fairer family agreement. A clearer view of what comes next.</p><p>Independent apps, each built around a question from real life. Here’s what you can use, what’s in testing, and what’s still taking shape.</p></div></header>
    <div class="product-grid">{work.map((project, index) => <article class="product"><a class="product-art" href={`/work/${project.slug}`} aria-label={`Explore ${project.name}`}><ProjectArtwork project={project} eager={index < 2} /></a><div class="product-heading"><h2><a href={`/work/${project.slug}`}>{project.name}</a></h2><span class:list={["product-status", { live: !!project.storeUrl }]}>{project.status}</span></div><p class="premise">{project.premise}</p><p class="summary">{project.summary}</p><a class="text-link" href={`/work/${project.slug}`}>Inside {project.name}</a></article>)}</div>
    <section class="product-ending"><h2>Something for your business?</h2><p>The same care goes into the websites and applications we build for clients.</p><a class="button-link secondary" href="/client-work">See client work</a></section>
  </div>
</PageLayout>
<style>
  .products-page{padding-bottom:2rem}.products-head{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end;padding:3.5rem 0}.products-head h1{font-size:clamp(3rem,5.5vw,5rem);margin:0}.products-head p:last-child{color:var(--ink-muted);font-size:.92rem;max-width:54ch;margin:0}.products-head .lede{font-size:1.2rem}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4rem 2.5rem}.product-art{display:block;height:370px;overflow:hidden;border-radius:8px}.product-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin:1.3rem 0 .5rem}.product-heading h2{font-size:2.4rem;margin:0}.product-heading a{color:var(--ink);text-decoration:none}.product-status{font-size:.7rem;color:var(--ink-muted);text-align:right}.product-status.live{color:var(--link)}.premise{font:400 1.4rem/1.3 var(--display);margin:0 0 .6rem}.summary{color:var(--ink-soft);font-size:.92rem;max-width:52ch;margin-bottom:1.3rem}.product .text-link{font-size:.82rem}.product-ending{border-top:1px solid var(--line);margin-top:4rem;padding-top:2.5rem}.product-ending h2{font-size:2rem}.product-ending p{color:var(--ink-soft)}@media(max-width:700px){.products-head{grid-template-columns:1fr;gap:1.5rem;padding-block:2.5rem}.products-head h1 br{display:none}.products-head h1{max-width:11ch}.product-grid{grid-template-columns:1fr;gap:3rem}.product-art{height:320px}.product-heading h2{font-size:2.2rem}.product-status{max-width:12ch}.product-ending{margin-top:3rem}}
</style>
